# MongoDB connection string (local Docker, Atlas, or mongodb-memory-server for tests)
MONGODB_URI=mongodb://localhost:27017/ai-interview-prep-kit

# Secret used to sign JWT auth cookies — set to a long random string
JWT_SECRET=

# Google Gemini API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

NODE_ENV=development
PORT=4000
