# MongoDB connection string (local Docker, Atlas, or mongodb-memory-server for tests)
MONGODB_URI=mongodb://localhost:27017/ai-interview-prep-kit

# Secret used to sign JWT auth cookies — set to a long random string
JWT_SECRET=ASSESMENT-SECRET123

# Google Gemini API key
GEMINI_API_KEY=

# Gemini model id. Default is current as of writing; override if it's retired/renamed.
GEMINI_MODEL=gemini-2.5-flash

NODE_ENV=development
PORT=4000
